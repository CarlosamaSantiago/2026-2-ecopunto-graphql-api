# ==========================================================
#  EcoPunto API — variables de entorno
#  Copia este archivo como .env  (cp .env.example .env)
#  Los valores de abajo ya funcionan con `docker compose up -d`
# ==========================================================

NODE_ENV=development
PORT=4100

# --- Base de datos (Postgres del docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=5434
DB_NAME=ecopunto
DB_USERNAME=postgres
DB_PASSWORD=postgres
# true = TypeORM crea/ajusta las tablas solo. Solo para desarrollo.
DB_SYNC=true
# true cuando la BD de la nube exige SSL (Render, Neon, Supabase...)
DB_SSL=false

# --- JWT ---
# Mínimo 16 caracteres. En producción usen uno largo y aleatorio.
JWT_SECRET=cambia-esto-por-un-secreto-largo-ecopunto
JWT_EXPIRES_IN=2h

# --- CORS: orígenes del front separados por coma ---
CORS_ORIGINS=http://localhost:3000

# --- Seed: habilita POST /api/seed ---
SEED_ENABLED=true
