# Variables para los tests e2e (pnpm test:e2e).
# Usa una BD aparte para no borrar sus datos de desarrollo.
# Este archivo SÍ va al repo (no tiene secretos reales).
NODE_ENV=test
PORT=4101
DB_HOST=localhost
DB_PORT=5434
DB_NAME=ecopunto_test
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SYNC=true
DB_SSL=false
JWT_SECRET=secreto-solo-para-tests-e2e-123
JWT_EXPIRES_IN=1h
CORS_ORIGINS=http://localhost:3000
SEED_ENABLED=true
